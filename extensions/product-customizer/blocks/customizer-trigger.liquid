{% if product %}
{% assign fabrixa_sku = product.metafields.app.fabrixa_sku.value | default: product.selected_or_first_available_variant.sku | default: '' %}
<script>
  window.__fabrixa = {
    sku: {{ fabrixa_sku | json }},
    appKey: {{ block.settings.application_key | json }},
    widgetBaseUrl: {{ block.settings.widget_base_url | json }},
    buttonLabel: {{ block.settings.button_label | json }}
  };
</script>
{% endif %}

{% schema %}
{
  "name": "Fabrixa Customizer",
  "target": "body",
  "javascript": "fabrixa-widget.js",
  "stylesheet": "fabrixa-widget.css",
  "settings": [
    {
      "type": "text",
      "id": "application_key",
      "label": "Fabrixa Application Key",
      "default": "788d6018-a36c-47e9-9ce3-b1f7e4bf4898"
    },
    {
      "type": "text",
      "id": "widget_base_url",
      "label": "Widget Base URL",
      "default": "https://dev-widget.fabrixa.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Customize this product"
    }
  ]
}
{% endschema %}